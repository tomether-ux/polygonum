# Django / deployment
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database
ALLOWED_HOSTS=polygonum.io,www.polygonum.io
SITE_URL=https://polygonum.io

# Email
SENDGRID_API_KEY=replace-with-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@polygonum.io
ADMIN_MODERATION_EMAIL=replace-with-moderation-email

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Internal services
POLYGONUM_WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_GESTIONALE_TOKEN=replace-with-a-long-random-secret

# Used only when explicitly running the superuser setup commands
DJANGO_SUPERUSER_USERNAME=replace-with-admin-username
DJANGO_SUPERUSER_EMAIL=replace-with-admin-email
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
